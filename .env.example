APP_ENV=dev
PORT=8000
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ---- Embedding ----
# 本地 Ollama（默认）
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# Ollama 不校验此值，但客户端要求非空
EMBEDDING_API_KEY=ollama

# 换成云端（以硅基流动为例，需实名认证，BAAI/bge-m3 免费）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-你的key

# 注意：换 embedding 模型后向量维度会变（bge-m3=1024，bge-small-zh=512），
# 必须重新执行 uv run python -m scripts.build_index 重建向量库。

# ---- 大模型（答案生成）----
# 本地 Ollama（默认）
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
# 医疗问答必须可复现，温度固定 0
LLM_TEMPERATURE=0.0

# 换成 DeepSeek（OpenAI 兼容，国内直连）
# 注意两点：
#   1) base_url 官方给的是 https://api.deepseek.com，**不带 /v1**
#   2) 模型名是 deepseek-flash / deepseek-v4-pro
#      旧的 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-你的key
# 推理模型默认就开着思考，想调深度就设这个（low / high / max）
# LLM_REASONING_EFFORT=high
# 想省钱省时间就显式关掉思考，走非思考模式
# LLM_THINKING=disabled

# 注意：思考模式下 temperature 不生效（服务端不报错也不采纳），
# 客户端会在思考模式下自动不发送这个参数。

# ---- 大模型备用（主模型不可用时自动降级到本地）----
# 三个值都配了才启用；把 LLM_FALLBACK_BASE_URL 置空 = 关闭降级。
# 触发条件：网络不通 / 服务端 5xx / 主模型重试耗尽。401、404 不触发（配置错误换模型没用）。
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=qwen2.5:7b
LLM_FALLBACK_API_KEY=ollama

# ---- 重排 ----
# 默认模型 BAAI/bge-reranker-v2-m3-int8（约 0.57GB），从 HuggingFace 下载
HF_ENDPOINT=https://hf-mirror.com

# ---- Docker 部署时 ----
# 容器内的 localhost 指容器自己，要访问宿主机的 Ollama 需改成：
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
